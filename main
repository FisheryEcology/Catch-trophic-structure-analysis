library(openxlsx)
library(EcoTroph)
ETconstruct <- function(dtuse, TLdata){
  tldata <- read.xlsx(TLdata)
  midres <- data.frame(1,2,3)
  colnames(midres) <- c('group_name','TL','biomass')
  for (k in 3:(dim(dtuse)[2]-2)){
    tempmidres = data.frame(colnames(dtuse[k]),
                            tldata[which(tldata$行标签 == colnames(dtuse[k])),][,3],
                            sum(dtuse[,k]))
    colnames(tempmidres) <- colnames(midres)
    midres <- rbind(midres,tempmidres)
  }
  ETuse = midres[-1,]
  ETuse$prod = 0
  ETuse$catch.1 = 0
  ETuse$catch.2 = 0
  ETuse$accessibility = 0
  ETuse$OI = 0
  #write.csv(ETuse,'tempETuse.csv')
  dty = ETuse
  dtz <- create.smooth(dty)
  dtzs = Transpose(dtz, dty, 'biomass')
  write.csv(dtzs,'temp.csv')
  dd = read.csv('temp.csv')
  EToutput = data.frame(1,2)
  colnames(EToutput) = c('TL','Catch')
  for (m in 1:dim(dd)[1]){
    subEToutput = data.frame(dd[m,1],sum(dd[m,2:dim(dd)[2]])/22648*1000)
    colnames(subEToutput) = colnames(EToutput)
    EToutput = rbind(EToutput,subEToutput)
  }
  return(EToutput[-1,])
}
Indcatorcalculate <- function(dtind){
  dtind$TL = as.numeric(dtind$TL)
  dtind$Catch = as.numeric(dtind$Catch)
  dt1 = dtind[which(dtind$TL>2.9 & dtind$TL<5.1),]
  dt2 = dtind[which(dtind$TL>1.9 & dtind$TL<5.1),]
  dt3 = dtind[which(dtind$TL>3.25 & dtind$TL<5.1),]
  ##
  linem = as.numeric(as.list(lm(formula = log10(as.numeric(dt1[,2]))~as.numeric(dt1[,1]))[["coefficients"]])[2])
  ##
  aline = as.numeric(dt2[,2])
  totbio = 0
  tottro = 0
  hightro = 0
  totppr = 0
  for (q in 1:dim(dt2)[1]){
    tlppr <- (aline[q]/9)*((1/0.1)^(as.numeric(dt2$TL[q])-1))
    totppr = totppr + tlppr
    totbio = totbio + aline[q]
    tottro = tottro + aline[q]*as.numeric(dt2[,1][q])
    if(as.numeric(dt2[,1][q]) > 3.9){hightro = hightro + aline[q]}
  }
  MTL <- tottro/totbio
  PPR <- totppr
  HTI <- 100*hightro/totbio
  
  ##
  hline <- as.numeric(dt3[,2])
  htotbio = 0
  htottro = 0
  aptro = 0
  for (q in 1:dim(dt3)[1]){
    htotbio = htotbio + hline[q]
    htottro = htottro + hline[q]*as.numeric(dt3[,1][q])
    if(as.numeric(dt3[,1][q]) > 3.9){aptro = aptro + hline[q]}
  }  
  MTI <- htottro/htotbio
  API <- 100*aptro/htotbio
  subresu <- data.frame(linem,MTL,PPR,HTI,MTI,API)
  colnames(subresu) <- colnames(resu) 
  return(subresu)
}
