library(EcoTroph)
#dtuse: A framework, with sample classification attributes in the first "metalows" column(s) and functional group–specific catch data in the remaining columns.
#metalows: The number of sample classification attributes.
#TLdata: A framework, with functional group name as the first column (named Group) and their trophic levels as the second column.
#dtind: A framework, with trophic levels as the first column (named TL) and their catch (named Catch)as the second column, , which matched the output data structure from function "ETconstruct". 
ETconstruct <- function(dtuse, TLdata, metalows = 2){
  midres <- data.frame(1,2,3)
  colnames(midres) <- c('group_name','TL','biomass')
  for (k in (metalows + 1):(dim(dtuse)[2])){
    tempmidres = data.frame(colnames(dtuse[k]),
                            tldata[which(tldata$Group == colnames(dtuse[k])),][,3],
                            sum(dtuse[,k]))
    colnames(tempmidres) <- colnames(midres)
    midres <- rbind(midres,tempmidres)
  }
  ETuse = midres[-1,]
  ETuse$prod = 0
  ETuse$catch.1 = 0
  ETuse$catch.2 = 0
  ETuse$accessibility = 0
  ETuse$OI = 0
  dty = ETuse
  dtz <- create.smooth(dty)
  dtzs = Transpose(dtz, dty, 'biomass')
  write.csv(dtzs,'temp.csv')
  dd = read.csv('temp.csv')
  EToutput = data.frame(1,2)
  colnames(EToutput) = c('TL','Catch')
  for (m in 1:dim(dd)[1]){
    subEToutput = data.frame(dd[m,1],sum(dd[m,2:dim(dd)[2]]))
    colnames(subEToutput) = colnames(EToutput)
    EToutput = rbind(EToutput,subEToutput)
  }
  return(EToutput[-1,])
}
Indcatorcalculate <- function(dtind){
  dtind$TL = as.numeric(dtind$TL)
  dtind$Catch = as.numeric(dtind$Catch)
  dt1 = dtind[which(dtind$TL>=3.0 & dtind$TL<=5.0),]
  dt2 = dtind[which(dtind$TL>=2.0 & dtind$TL<=5.0),]
  dt3 = dtind[which(dtind$TL>=3.25 & dtind$TL<=5.0),]
  ##
  linem = as.numeric(as.list(lm(formula = log10(as.numeric(dt1[,2]))~as.numeric(dt1[,1]))[["coefficients"]])[2])
  ##
  aline = as.numeric(dt2[,2])
  totbio = 0
  tottro = 0
  hightro = 0
  totppr = 0
  for (q in 1:dim(dt2)[1]){
    tlppr <- (aline[q]/9)*((1/0.1)^(as.numeric(dt2$TL[q])-1))
    totppr = totppr + tlppr
    totbio = totbio + aline[q]
    tottro = tottro + aline[q]*as.numeric(dt2[,1][q])
    if(as.numeric(dt2[,1][q]) > 3.9){hightro = hightro + aline[q]}
  }
  MTL <- tottro/totbio
  PPR <- totppr
  HTI <- 100*hightro/totbio
  
  ##
  hline <- as.numeric(dt3[,2])
  htotbio = 0
  htottro = 0
  aptro = 0
  for (q in 1:dim(dt3)[1]){
    htotbio = htotbio + hline[q]
    htottro = htottro + hline[q]*as.numeric(dt3[,1][q])
    if(as.numeric(dt3[,1][q]) > 3.9){aptro = aptro + hline[q]}
  }  
  MTI <- htottro/htotbio
  API <- 100*aptro/htotbio
  subresu <- data.frame(linem,MTL,PPR,HTI,MTI,API)
  colnames(subresu) <- colnames(resu) 
  return(subresu)
}
